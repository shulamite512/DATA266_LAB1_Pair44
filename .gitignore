# Python and notebook tooling
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.pytest_cache/
.mypy_cache/
.venv/
venv/
env/

# OS and editor files
.DS_Store
Thumbs.db
*.swp
*~

# Secrets and credentials
.env
.env.*
*.token
kaggle.json
.kaggle/
.huggingface/

# Datasets are shared through Google Drive (see README), not committed.
# Only the per-task data READMEs are tracked.
task*/data/*
!task*/data/README.md
**/data_processed/

# Development and resume checkpoints only; the final model files stay tracked:
#   task1_llm/parth/checkpoints/best.pt, task1_llm/shulamite/checkpoints/best.pt
#   task2_sentiment/parth/checkpoints/{logreg_tfidf.joblib, best_neural.pt, best_neural_cnn.pt}
#   task2_sentiment/shulamite/checkpoints/*.pt and vocab.json
#   task3_gan/parth/checkpoints/<EXP-05 run>/final_generators.pt
**/checkpoints/**/latest*.pt
**/checkpoints/smoke/
**/checkpoints/**/full_epoch_*.pt
**/checkpoints/**/generators_epoch_*.pt
*.pth
*.ckpt
*.tmp
# Task 1 keeps only best.pt; the per-epoch "last.pt" is a backup
task1_llm/*/checkpoints/last.pt

# Smoke-test, demo and scratch outputs
**/smoke_test/
task1_llm/*/figures/smoke/
task1_llm/*/logs/smoke/
task1_llm/*/outputs/smoke/
task2_sentiment/*/smoke_runs/
**/notebook_runs/smoke*/
**/outputs/demo/
**/scratch/

# Archives and partial downloads (datasets are shared as a zip on Drive, not through git)
*.zip
*.tgz
*.tar.gz
*.part
